cc_library_static {
    name: "libaudiohalutils.qti",
    defaults: [
        "qti_audio_aidl_core_ndk_shared",
        "qti_audio_aidl_common_types_ndk_shared",
    ],
    owner: "qti",
    vendor: true,

    cflags: [
        "-DBACKEND_NDK",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wthread-safety",
    ],

    srcs: ["Utils.cpp"],

    export_include_dirs: ["include"],

    local_include_dirs: ["include"],

    header_libs: ["libaudio_system_headers"],

    shared_libs: [
        "libaudioutils",
        "libbase",
        "libutils",
        "qti-audio-types-aidl-V1-ndk",
    ],
}
